{
  "name": "Prediction",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string",
      "description": "Reference to the Player"
    },
    "game_id": {
      "type": "string",
      "description": "Reference to the Game"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to the Category"
    },
    "pick": {
      "type": "string",
      "description": "The player's pick (driver name, yes/no, or JSON for multi-pick)"
    },
    "confidence_points": {
      "type": "integer",
      "description": "Points allocated to this category (max 30)"
    },
    "points_earned": {
      "type": "number",
      "default": 0,
      "description": "Points earned after scoring"
    },
    "is_correct": {
      "type": "boolean",
      "description": "Whether the prediction was correct"
    }
  },
  "required": ["player_id", "game_id", "category_id", "pick", "confidence_points"]
}
